{{- $link := partial "render-link/resolve.html" . -}}
{{- $destination := $link.destination -}}
{{- $href := $destination -}}
{{- if strings.HasPrefix $destination "#" -}}
	{{- $href = printf "%s%s" .Page.Permalink $destination -}}
{{- else if not $link.scheme -}}
	{{- $href = $destination | absURL -}}
{{- end -}}
<a href="{{ $href | safeURL }}"{{ with .Title }} title="{{ . }}"{{ end }}>{{ .Text }}</a>{{- "" -}}
