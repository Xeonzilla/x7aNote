{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
{{- $pages := (where site.RegularPages "Section" "posts").ByLastmod.Reverse }}
{{- $feedPages := first 20 $pages }}
{{- $updated := (index $feedPages 0).Lastmod }}
{{- /* Pages are activity-sorted, so feed updated tracks the newest emitted activity. */ -}}
<feed xmlns="http://www.w3.org/2005/Atom">
	<id>{{ .Permalink }}</id>
	<title>{{ site.Title | transform.XMLEscape | safeHTML }}</title>
	<subtitle>{{ site.Params.description | transform.XMLEscape | safeHTML }}</subtitle>
	<updated>{{ $updated.Format "2006-01-02T15:04:05Z07:00" }}</updated>
	<link href="{{ .Permalink }}" rel="alternate"/>
	<link href="{{ "feed.xml" | absURL }}" rel="self"/>
	<author>
		<name>{{ site.Params.author | transform.XMLEscape | safeHTML }}</name>
	</author>
	<rights>{{ printf "%s: %s" site.Params.license.name site.Params.license.url | transform.XMLEscape | safeHTML }}</rights>
	{{- range $feedPages }}
		{{- $summary := .Summary | plainify | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace }}
		<entry>
			<id>{{ .Permalink }}</id>
			<title>{{ .Title | transform.XMLEscape | safeHTML }}</title>
			<published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
			<updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
			<link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
			<summary type="text">{{ $summary | transform.XMLEscape | safeHTML }}</summary>
			<content type="html">{{ .Content | transform.XMLEscape | safeHTML }}</content>
		</entry>
	{{- end }}
</feed>
