{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
{{- $pages := (where site.RegularPages "Section" "posts").ByDate.Reverse }}
{{- $feedPages := first 20 $pages }}
{{- $siteConfig := partialCached "site-config.html" site "site-config" }}
{{- $siteBaseURL := strings.TrimSuffix "/" site.BaseURL }}
{{- $latestFeedPage := index $feedPages 0 }}
{{- $updated := cond $latestFeedPage.Lastmod.IsZero $latestFeedPage.Date $latestFeedPage.Lastmod }}
{{- /* Feed updated tracks emitted entries, not the build timestamp. */ -}}
{{- range after 1 $feedPages }}
	{{- $pageUpdated := cond .Lastmod.IsZero .Date .Lastmod }}
	{{- if gt $pageUpdated.Unix $updated.Unix }}
		{{- $updated = $pageUpdated }}
	{{- end }}
{{- end }}
<feed xmlns="http://www.w3.org/2005/Atom">
	<id>{{ .Permalink }}</id>
	<title>{{ site.Title | html }}</title>
	<subtitle>{{ $siteConfig.description | html }}</subtitle>
	<updated>{{ $updated.Format "2006-01-02T15:04:05Z07:00" }}</updated>
	<link href="{{ .Permalink }}" rel="alternate"/>
	<link href="{{ "feed.xml" | absURL }}" rel="self"/>
	<author>
		<name>{{ $siteConfig.author | html }}</name>
	</author>
	<rights>{{ printf "%s: %s" $siteConfig.license.name $siteConfig.license.url | html }}</rights>
	{{- range $feedPages }}
		{{- $summary := .Summary | plainify | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace }}
		{{- $content := .Content | replaceRE `\b(href|src)="(/[^"/][^"]*)"` (printf `${1}="%s${2}"` $siteBaseURL) }}
		{{- $markdownOutput := .OutputFormats.Get "markdown" -}}
		{{- if not $markdownOutput -}}
			{{- partial "fail.html" (dict
				"area" "output"
				"problem" "missing Markdown output"
				"location" .File.Path
				"expected" "a markdown output format for posts"
				"got" "<missing>"
				"fix" "restore the posts markdown output cascade in hugo.toml"
				)
			-}}
		{{- end }}
		<entry>
			<id>{{ .Permalink }}</id>
			<title>{{ .Title | html }}</title>
			<published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
			<updated>{{ (cond .Lastmod.IsZero .Date .Lastmod).Format "2006-01-02T15:04:05Z07:00" }}</updated>
			<link href="{{ .Permalink }}" rel="alternate"/>
			<link href="{{ $markdownOutput.Permalink }}" rel="alternate" type="text/markdown"/>
			<summary type="text">{{ $summary | html }}</summary>
			<content type="html">{{ $content | html }}</content>
		</entry>
	{{- end }}
</feed>
