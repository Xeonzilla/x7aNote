{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $posts := where site.RegularPages "Section" "posts" }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	{{- /* Sitemap includes permalinked rendered pages unless front matter sets sitemap.disable. */ -}}
	{{- range site.Pages }}
		{{- if and .Permalink (not .Sitemap.Disable) }}
			{{- $lastmod := "" -}}
			{{- if or .IsHome (eq .Kind "taxonomy") (eq .Kind "term") }}
				{{- $activityPages := cond (eq .Kind "term") .Pages $posts -}}
				{{- range $activityPages }}
					{{- $pageLastmod := .Lastmod -}}
					{{- if or (not $lastmod) (gt $pageLastmod.Unix $lastmod.Unix) }}
						{{- $lastmod = $pageLastmod -}}
					{{- end }}
				{{- end }}
			{{- else if .IsPage }}
				{{- $lastmod = .Lastmod -}}
			{{- else if not .Lastmod.IsZero }}
				{{- $lastmod = .Lastmod -}}
			{{- end }}
			<url>
				<loc>{{ .Permalink }}</loc>
				{{- with $lastmod }}
					<lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>
				{{- end }}
			</url>
		{{- end }}
	{{- end }}
</urlset>
