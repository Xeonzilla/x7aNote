{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $posts := (site.GetPage "/posts").RegularPages }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	{{- /* Sitemap includes permalinked rendered pages unless front matter sets sitemap.disable. */ -}}
	{{- range site.Pages }}
		{{- if and .Permalink (not .Sitemap.Disable) }}
			{{- $lastmod := .Lastmod -}}
			{{- if or .IsHome (eq .Kind "taxonomy") (eq .Kind "term") }}
				{{- /* A listing is as fresh as the newest post it lists; an empty one carries no lastmod. */ -}}
				{{- $lastmod = "" -}}
				{{- range first 1 (cond (eq .Kind "term") .Pages $posts).ByLastmod.Reverse }}
					{{- $lastmod = .Lastmod -}}
				{{- end }}
			{{- end }}
			<url>
				<loc>{{ .Permalink }}</loc>
				{{- with $lastmod }}
					<lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>
				{{- end }}
			</url>
		{{- end }}
	{{- end }}
</urlset>
