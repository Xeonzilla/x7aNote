{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash vercel-build.sh",
  "framework": "hugo",
  "headers": [
    {
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; script-src 'none'; script-src-attr 'none'; style-src 'self'; style-src-elem 'self'; style-src-attr 'none'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; form-action 'self' https://api.staticforms.dev; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=()"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Link",
          "value": "</robots.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"index\"; type=\"application/xml\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        }
      ],
      "source": "/((?!.*\\.).*|404\\.html)"
    },
    {
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ],
      "source": "/((?!favicon-96x96\\.png$|favicon\\.svg$|favicon\\.ico$|images/).*)"
    },
    {
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ],
      "source": "/:asset(favicon-96x96\\.png|favicon\\.svg|favicon\\.ico|images/.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/(css|images|open-graph)/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=utf-8"
        }
      ],
      "source": "/feed.xml"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=86400, stale-while-revalidate=86400"
        }
      ],
      "source": "/:asset(llms\\.txt|robots\\.txt|sitemap\\.xml)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=86400, stale-while-revalidate=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/:slug\\.md"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ],
      "source": "/:asset(favicon\\.ico|favicon\\.svg|favicon-96x96\\.png)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "source": "/404.html"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "source": "/message-sent(/?)"
    }
  ],
